# =============================================================================
# AiStock Agent Python — 环境变量模板
# 复制为 .env.development（本地开发）或 .env.production（服务器生产）
# .env.* 文件不提交 git，仅此模板提交
# =============================================================================

# Node.js 后端地址
NODE_API_BASE_URL=http://localhost:3000
STOCK_TRACE_REDIS_URL=redis://localhost:6379/2
STOCK_TRACE_CONSUMER_GROUP=stock-trace-workers
STOCK_TRACE_PENDING_CLAIM_IDLE_MS=3000
STOCK_TRACE_MAX_ATTEMPTS=3
STOCK_TRACE_STRUCTURED_OUTPUT_METHOD=function_calling

# 自选股洞察（watchlist insight，独立 Redis db=3）
INSIGHT_REDIS_URL=redis://localhost:6379/3
INSIGHT_CONSUMER_GROUP=watchlist-insight-workers
INSIGHT_CONSUMER_BLOCK_MS=1000
INSIGHT_PENDING_CLAIM_IDLE_MS=3000
INSIGHT_MAX_ATTEMPTS=3
INSIGHT_CONSUMER_ENABLED=true
INSIGHT_STRUCTURED_OUTPUT_METHOD=json_mode
INSIGHT_LABEL_MAX_CHARS=12
INSIGHT_LLM_MODEL=quick_think

# LLM — quick_think（默认 API）
OPENAI_API_KEY=sk-your-api-key
OPENAI_BASE_URL=https://api.deepseek.com/v1

# LLM — deep_think（可使用不同 API，留空则 fallback 到上面）
DEEP_THINK_API_KEY=
DEEP_THINK_BASE_URL=

# 双模型策略
QUICK_THINK_MODEL=deepseek-v4-flash
DEEP_THINK_MODEL=deepseek-v4-pro

# Redis
REDIS_URL=redis://localhost:6379/1

# LangGraph checkpointer 后端（memory / sqlite / redis；默认 memory=进程内，重启丢会话）
# sqlite：文件持久、零外部依赖（兜底推荐；SQLITE_PATH 相对 cwd）
# redis：需 Redis 支持 RedisJSON（JSON.SET 指令），且 db 须与 RedisPool(默认 db=1)/
#        stock_trace(db=2) 隔离——用独立 db（如 /3）改写 REDIS_URL 或配独立 URL
CHECKPOINTER_BACKEND=sqlite
SQLITE_PATH=.langgraph.db

# Tavily API 池
TAVILY_API_KEYS=tvly-dev-xxx1, tvly-dev-xxx2

# Python 服务
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=info

# 内网鉴权
INTERNAL_API_TOKEN=your-internal-api-token

# CORS
CORS_ORIGINS=*

# 补充节假日表（YYYY-MM-DD，逗号分隔或 JSON 数组；空=不启用）
# 用途：chinese_calendar 仅覆盖 2004-2026，2027 起节假日（休市日）在此补充，
# 让 is_trading_day 越年判定恢复精度（如 HOLIDAYS_EXTRA=2027-01-01,2027-10-01）
HOLIDAYS_EXTRA=

# 火山引擎 TTS
VOLC_TTS_APP_ID=your-app-id
VOLC_TTS_ACCESS_TOKEN=your-access-token
VOLC_TTS_SECRET_KEY=your-secret-key

# 定时任务
SCHEDULER_ENABLED=false

# 大盘溯源后接预测（独立模块，SPEC 硬约束 1）
# 生产必须 true（事件驱动：quick snapshot 15:30 后自动接预测）；
# false 属旧串行链路，自动预测会断链、只剩手动兜底
QUICK_SNAPSHOT_ENABLED=true

# 抖音视频转写（硅基流动 SenseVoice）
DOUYIN_API_KEY=sk-your-siliconflow-key
# 可选：显式指定 ffmpeg/ffprobe 路径（默认走 PATH）
FFMPEG_BINARY=
FFPROBE_BINARY=

# ===== 迭代 Agent 自动闭环（iterate）=====
# 默认关闭；服务器沙盒开启后跑"历史切片→标准答案→变体实验→归因评估"闭环
ITERATE_ENABLED=false
# 每日汇总报告：交易日 16:00（非交易日跳过）
ITERATE_CRON=0 16 * * 1-5
ITERATE_MAX_ROUNDS=5
ITERATE_TARGET_SCORE=0.8
ITERATE_MAX_DAILY_CASES=3
ITERATE_ROUND_TIMEOUT_SECONDS=600

# ===== QQ 邮箱 SMTP（每日报告发送；smtp.qq.com:465 SSL + 授权码）=====
# 授权码：QQ 邮箱网页版 → 设置 → 账户 → 开启 SMTP 服务生成（16 位，非登录密码）
# ⚠️ 只填本地 .env，不进 git（本模板仅占位）
QQ_SMTP_USER=3677347180@qq.com
QQ_SMTP_AUTH=your-16-char-smtp-auth-code
QQ_SMTP_TO=1392394875@qq.com
# 可选：迭代专属命名（优先于 QQ_SMTP_*）
# ITERATE_SMTP_HOST=smtp.qq.com
# ITERATE_SMTP_PORT=465
# ITERATE_SMTP_USER=3677347180@qq.com
# ITERATE_SMTP_PASSWORD=your-16-char-smtp-auth-code
# ITERATE_MAIL_TO=1392394875@qq.com
