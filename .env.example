# =============================================================================
# AiStock Agent Python 服务 — 环境变量模板
# 复制为 .env 后填入实际值，.env 不提交 git
# =============================================================================

# -----------------------------------------------------------------------------
# Node.js 后端地址（数据层）
# 本地开发：http://localhost:3000
# 生产环境：docker-compose 内网名，如 http://aistock-api:3000
# -----------------------------------------------------------------------------
NODE_API_BASE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# LLM（兼容 OpenAI 接口的任意服务）
# -----------------------------------------------------------------------------
OPENAI_API_KEY=sk-xxx
OPENAI_BASE_URL=https://api.openai.com/v1

# 双模型策略：路由用快模型，深度分析用慢模型
QUICK_THINK_MODEL=gpt-4o-mini
DEEP_THINK_MODEL=gpt-4o

# 双模型参数（temperature / max_tokens，避免硬编码）
QUICK_THINK_TEMPERATURE=0.1
QUICK_THINK_MAX_TOKENS=2000
DEEP_THINK_TEMPERATURE=0.3
DEEP_THINK_MAX_TOKENS=4000

# -----------------------------------------------------------------------------
# Redis（与 Node.js 共用实例，db=1 隔离 key 空间）
# 本地：redis://localhost:6379/1
# docker-compose：redis://redis:6379/1
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/1
# 连接池最大连接数（main.py lifespan 传给 RedisPool.init）
REDIS_MAX_CONNECTIONS=10

# -----------------------------------------------------------------------------
# HTTP 客户端超时（main.py lifespan 传给 HttpClientPool.init）
# 单位：秒
# -----------------------------------------------------------------------------
HTTP_TIMEOUT_SECONDS=10.0

# -----------------------------------------------------------------------------
# Tavily API 池（7人团队共享额度）
# 将所有成员的 Key 用逗号拼接填入 TAVILY_API_KEYS，每次请求随机选取一个
#
# 示例（替换为真实 Key）：
#   TAVILY_API_KEYS=tvly-xxxxx1,tvly-xxxxx2,tvly-xxxxx3,...
#
# 若只有单个 Key，也可只填 TAVILY_API_KEY（向下兼容）
# -----------------------------------------------------------------------------
TAVILY_API_KEYS=tvly-key1,tvly-key2,tvly-key3,tvly-key4,tvly-key5,tvly-key6,tvly-key7
# TAVILY_API_KEY=tvly-xxx   # 单 Key 兼容模式

# -----------------------------------------------------------------------------
# Python 服务配置
# 端口 8000；Node.js 3000 通过 /api/agent/* 反代到本服务
# -----------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# 内网鉴权（Node.js → Python 内部接口校验 Header）
# 生产环境请换成随机强密钥
# -----------------------------------------------------------------------------
INTERNAL_API_TOKEN=change-me-in-production

# -----------------------------------------------------------------------------
# LangSmith 追踪（默认关闭，生产按需开启）
# 开启后需设置 LANGSMITH_API_KEY，trace 会推送到 LangSmith 平台
# -----------------------------------------------------------------------------
LANGSMITH_ENABLED=false
# LANGSMITH_API_KEY=lsv2_xxx
LANGSMITH_PROJECT=aistock-agent
