# =============================================================================
# AiStock Agent Python — 环境变量模板
# 复制为 .env.development（本地开发）或 .env.production（服务器生产）
# .env.* 文件不提交 git，仅此模板提交
# =============================================================================

# Node.js 后端地址
NODE_API_BASE_URL=http://localhost:3000
STOCK_TRACE_REDIS_URL=redis://localhost:6379/2
STOCK_TRACE_CONSUMER_GROUP=stock-trace-workers
STOCK_TRACE_PENDING_CLAIM_IDLE_MS=3000
STOCK_TRACE_MAX_ATTEMPTS=3
STOCK_TRACE_STRUCTURED_OUTPUT_METHOD=function_calling

# 自选股洞察（watchlist insight，独立 Redis db=3）
INSIGHT_REDIS_URL=redis://localhost:6379/3
INSIGHT_CONSUMER_GROUP=watchlist-insight-workers
INSIGHT_CONSUMER_BLOCK_MS=1000
INSIGHT_PENDING_CLAIM_IDLE_MS=3000
INSIGHT_MAX_ATTEMPTS=3
INSIGHT_CONSUMER_ENABLED=true
INSIGHT_STRUCTURED_OUTPUT_METHOD=json_mode
INSIGHT_LABEL_MAX_CHARS=12
INSIGHT_LLM_MODEL=quick_think

# LLM — quick_think（默认 API）
OPENAI_API_KEY=sk-your-api-key
OPENAI_BASE_URL=https://api.deepseek.com/v1

# LLM — deep_think（可使用不同 API，留空则 fallback 到上面）
DEEP_THINK_API_KEY=
DEEP_THINK_BASE_URL=

# 双模型策略
QUICK_THINK_MODEL=deepseek-v4-flash
DEEP_THINK_MODEL=deepseek-v4-pro

# Redis
REDIS_URL=redis://localhost:6379/1

# LangGraph checkpointer 后端（memory / sqlite / redis；默认 memory=进程内，重启丢会话）
# sqlite：文件持久、零外部依赖（兜底推荐；SQLITE_PATH 相对 cwd）
# redis：需 Redis 支持 RedisJSON（JSON.SET 指令），且 db 须与 RedisPool(默认 db=1)/
#        stock_trace(db=2) 隔离——用独立 db（如 /3）改写 REDIS_URL 或配独立 URL
CHECKPOINTER_BACKEND=sqlite
SQLITE_PATH=.langgraph.db

# Tavily API 池
TAVILY_API_KEYS=tvly-dev-xxx1, tvly-dev-xxx2

# Python 服务
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=info

# 内网鉴权
INTERNAL_API_TOKEN=your-internal-api-token

# CORS
CORS_ORIGINS=*

# 火山引擎 TTS
VOLC_TTS_APP_ID=your-app-id
VOLC_TTS_ACCESS_TOKEN=your-access-token
VOLC_TTS_SECRET_KEY=your-secret-key

# 定时任务
SCHEDULER_ENABLED=false
