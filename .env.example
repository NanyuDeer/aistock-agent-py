# Node.js 后端地址（Python 通过此地址调用 /internal/* API）
NODE_API_BASE_URL=http://localhost:3000

# LLM 配置
OPENAI_API_KEY=sk-xxx
OPENAI_BASE_URL=https://api.openai.com/v1
QUICK_THINK_MODEL=gpt-4o-mini
DEEP_THINK_MODEL=gpt-4o

# Redis（会话持久化 + 晨报缓存）
REDIS_URL=redis://localhost:6379/1

# Tavily（全网财经搜索）
TAVILY_API_KEY=tvly-xxx

# 服务配置
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info

# 内网鉴权（Node.js → Python 调用时携带）
INTERNAL_API_TOKEN=change-me-in-production
