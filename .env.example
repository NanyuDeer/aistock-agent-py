# =============================================================================
# AiStock Agent Python — 环境变量模板
# 复制为 .env.development（本地开发）或 .env.production（服务器生产）
# .env.* 文件不提交 git，仅此模板提交
# =============================================================================

# Node.js 后端地址
NODE_API_BASE_URL=http://localhost:3000

# LLM — quick_think（默认 API）
OPENAI_API_KEY=sk-your-api-key
OPENAI_BASE_URL=https://api.deepseek.com/v1

# LLM — deep_think（可使用不同 API，留空则 fallback 到上面）
DEEP_THINK_API_KEY=
DEEP_THINK_BASE_URL=

# 双模型策略
QUICK_THINK_MODEL=deepseek-v4-flash
DEEP_THINK_MODEL=deepseek-v4-pro

# Redis
REDIS_URL=redis://localhost:6379/1

# Tavily API 池
TAVILY_API_KEYS=tvly-dev-xxx1, tvly-dev-xxx2

# Python 服务
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=info

# 内网鉴权
INTERNAL_API_TOKEN=your-internal-api-token

# CORS
CORS_ORIGINS=*

# 火山引擎 TTS
VOLC_TTS_APP_ID=your-app-id
VOLC_TTS_ACCESS_TOKEN=your-access-token
VOLC_TTS_SECRET_KEY=your-secret-key

# 定时任务
SCHEDULER_ENABLED=false
