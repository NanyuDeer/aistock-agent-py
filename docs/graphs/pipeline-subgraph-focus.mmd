---
config:
  flowchart:
    curve: basis
---
flowchart TD

    %% ============ 入口（事件驱动，统一进管线） ============
    subgraph IN["入口（事件驱动，统一进管线）"]
        direction LR
        C2["定时 · 08:50 晨报"]
        C4["定时 · 15:30/20:30 复盘"]
        SC["异动事件 · stock-trace"]
        CHAT["对话 · 深度分析"]
    end

    %% ============ 四步管线子图（重构核心） ============
    subgraph PIPE["四步管线子图（subject 参数化：个股 / 大盘 / 板块 / 事件）"]
        direction LR
        P1["01 预判\n方向 + 根因影响持续性推演（短 / 中 / 长期）"] --> P2["02 溯源\n六阶段归因 → 根因"] --> P3["03 对照\n根因消化验证（各档到期回写）"] --> P4["04 迭代\n偏差反馈"] --> RPT["报告生成\n双层契约 + 播报"]
        ROOT["根因（structural_root）"]
        P2 --> ROOT
        ROOT -. "根因驱动下一轮预判" .-> P1
        P4 -. "校正预判提示词 / 数据源" .-> P1
    end

    %% ============ 证据底座（能力层，只读） ============
    subgraph EV["证据底座（能力层，确定性计算，只读）"]
        direction LR
        E1["统一事件库"]
        E2["行情 / 新闻 / 快照"]
        E3["冻结快照"]
        E4["知识图谱"]
    end

    %% ============ 产出（统一落库 → App / 推送） ============
    subgraph OUT["产出"]
        direction LR
        O1["统一报告存储（subject × step × date）"]
        O2["预测验证（prediction_records · 短中长档）"]
        O3["播报音频（TTS）"]
    end

    %% ============ 连线 ============
    C2 --> P1
    C4 --> P1
    SC --> P1
    CHAT --> P1

    E1 --> P2
    E2 --> P1
    E2 --> P2
    E3 --> P3
    E4 --> P2

    RPT --> O1
    P3 --> O2
    RPT --> O3
